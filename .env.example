# Triskel Gate API (backend de tickets/pagos)
VITE_TRISKELL_API_BASE_URL=http://localhost:3001

# Evento activo en Triskel Gate
VITE_TRISKELL_EVENT_ID=1

# Sessionize event slug (https://sessionize.com/api/v2/{slug}/view/...)
VITE_SESSIONIZE_EVENT_ID=xops-conference-2025

# NEVER prefix these with VITE_: server-only Vercel Function variables.
# HOLOS_CRM_API_URL must be a trusted HTTPS URL ending in /api/v1.
HOLOS_CRM_API_URL=
HOLOS_CRM_API_KEY=

# Complete only after checking actual registered office and association registry.
VITE_HACKER_DREAMS_ADDRESS=
VITE_HACKER_DREAMS_REGISTRY=
VITE_ODIN_LEGAL_ADDRESS=
